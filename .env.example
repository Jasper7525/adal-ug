# GEMINI_API_KEY: Required for Gemini AI API calls.
# The deployment environment injects this runtime secret automatically.
# Users configure this value through the runtime secret configuration.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# The deployment environment injects this runtime URL automatically.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
