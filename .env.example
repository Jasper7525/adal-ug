# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Public application URL.
APP_URL="http://localhost:3000"

# Express server configuration
PORT=3001
NODE_ENV=development

# PostgreSQL configuration
DATABASE_URL=postgres://postgres:<password>@localhost:5432/adal_ug

# Administrator login credentials. Use unique values in production.
# ADMIN_PASSWORD must be at least 12 characters with uppercase, lowercase, number and symbol.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ReplaceWithA_Strong12+CharacterPassword!

# Secret used to authorize an administrator password reset request.
# Generate a long random value and store it only in the deployment environment.
ADMIN_RESET_TOKEN=ReplaceWithALongRandomResetSecret

# Optional persistent upload directory. On Render, point this at the mount path
# of a persistent disk, or replace local disk storage with object storage.
# UPLOAD_DIR=/var/data/uploads
